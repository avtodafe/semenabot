# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env

# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ID канала: числовой (-100...) или @username
CHANNEL_ID=@your_channel_name

# SQLite — файл в текущей папке (менять не нужно)
DATABASE_URL=sqlite:///semenabot.db

# Минимальная цена тендера (руб.)
MIN_PRICE=500000
